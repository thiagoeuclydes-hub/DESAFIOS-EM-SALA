rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidGameTemplate(data) {
      return data.title is string && data.title.size() <= 100 &&
             data.type in ['quiz', 'true_false', 'challenge', 'colors', 'stay_or_leave'] &&
             data.teacherId == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidGameSession(data) {
      return data.gameTemplateId is string &&
             data.teacherId == request.auth.uid &&
             data.pin is string && data.pin.size() == 6 &&
             data.status in ['waiting', 'playing', 'finished'] &&
             data.createdAt == request.time;
    }

    function isValidPlayer(data) {
      return data.nickname is string && data.nickname.size() <= 30 &&
             data.score is number &&
             data.joinedAt is timestamp;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if true; // Allowed for prototype auto-creation
    }

    match /gameTemplates/{gameId} {
      allow read, write: if true;
    }

    match /sessions/{sessionId} {
      allow read, write: if true;
    }

    match /sessions/{sessionId}/players/{playerId} {
      allow read, write: if true;
    }
  }
}
